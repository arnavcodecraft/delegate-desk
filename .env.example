# Copy to .env (or set in your host's environment). Every value is optional in development.
PORT=8080
BASE_URL=https://register.example.org      # public URL; used in emails, webhooks, payment return links
APP_SECRET=change-me-to-a-long-random-string # signs private file links and sandbox webhooks
DB_PATH=./data/delegatedesk.db
UPLOAD_DIR=./data/uploads

# Email (any SMTP provider with SPF/DKIM/DMARC set up for your domain). Without it, mail is logged in Messages.
SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM="BGYS 2027 <registrations@example.org>"

# Razorpay: Dashboard → Settings → API keys, and Webhooks (URL: $BASE_URL/api/webhooks/razorpay,
# events: payment.captured, payment.failed, payment.authorized, refund.processed, refund.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree PG (notify URL is set per order: $BASE_URL/api/webhooks/cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                         # or production
CASHFREE_API_VERSION=2023-08-01

# Built-in sandbox gateway: always on in development; set to 1 to allow it in production (demos only).
ALLOW_SANDBOX=0
# JOBS=off                                   # disable background jobs (e.g. on a second instance)
