# Copy to .env (or set in your host's environment). Every value is optional in development.
PORT=8080
BASE_URL=https://register.example.org      # public URL; used in emails, webhooks, payment return links
# Behind Cloudflare Pages: BASE_URL is the Pages address; TRUST_PROXY=2 if the server also sits behind its host's proxy;
# PROXY_SECRET (same value as in Pages) makes the server refuse requests that did not come through Pages.
# TRUST_PROXY=1
# PROXY_SECRET=
APP_SECRET=change-me-to-a-long-random-string # signs private file links and sandbox webhooks
DB_PATH=./data/delegatedesk.db
UPLOAD_DIR=./data/uploads

# Email (any SMTP provider with SPF/DKIM/DMARC set up for your domain). Without it, mail is logged in Messages.
SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM="BGYS 2027 <registrations@example.org>"

# Razorpay: Dashboard → Settings → API keys, and Webhooks (URL: $BASE_URL/api/webhooks/razorpay,
# events: payment.captured, payment.failed, payment.authorized, refund.processed, refund.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree PG (notify URL is set per order: $BASE_URL/api/webhooks/cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                         # or production
CASHFREE_API_VERSION=2023-08-01

# Built-in sandbox gateway: always on in development; set to 1 to allow it in production (demos only).
ALLOW_SANDBOX=0
# JOBS=off                                   # disable background jobs (e.g. on a second instance)

# WhatsApp Business (Meta Cloud API). Approve a template per message in WhatsApp Manager and enter its
# name in Messages → template → WhatsApp. Webhook URL: $BASE_URL/api/webhooks/whatsapp (field: messages).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                         # verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=                       # any string; type the same one in the Meta webhook setup
# WHATSAPP_API_VERSION=v21.0

# SMS via MSG91 Flow API (DLT-registered templates; enter the flow id per template in Messages).
MSG91_AUTH_KEY=

# Virus scanning: a clamd daemon (e.g. the clamav/clamav Docker image). Without it, uploads still get
# type sniffing and PDF script/JS checks. Set CLAMAV_REQUIRED=1 to refuse uploads when clamd is down.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=0

# Google Sheets live lists: a service account with the Sheets API enabled. Paste the JSON key (one line)
# or point to the file. Share each spreadsheet with the service account's email as an editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json

# AI assistance (bill reading, proof cross-checks, dashboard notes, staff questions). Off without a key.
ANTHROPIC_API_KEY=

# On-device OCR of payment screenshots and bills (Tesseract, no data leaves the server). On by default.
# OCR=off

# Encrypted daily backups (database + uploads, AES-256-GCM), restore-tested after each run.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy of the key offline: backups cannot be restored without it.
BACKUP_KEY=
BACKUP_DIR=./data/backups
BACKUP_KEEP=30
# BACKUPS=off

# AI (optional). Either Claude or Google Gemini (AI Studio key). With both, Claude is used unless AI_PROVIDER=gemini.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=            # aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash   # tried first; lighter models are used if it is busy or over quota
# AI_PROVIDER=gemini
# AI_DAILY_LIMIT=50          # AI requests per person per day in Prep
# Email (pick one): RESEND_API_KEY=re_...  |  BREVO_API_KEY=xkeysib-...  |  SMTP_URL=smtps://user:pass@smtp.gmail.com:465
# MAIL_FROM=Your Conference <hello@yourdomain.com>
