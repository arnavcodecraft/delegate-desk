{
  "name": "DelegateDesk",
  "short_name": "DelegateDesk",
  "description": "Run your Model UN conference. Prepare for committee.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f6f8fc",
  "theme_color": "#1f4fe0",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Prep", "url": "/prep", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Live session", "url": "/session", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
