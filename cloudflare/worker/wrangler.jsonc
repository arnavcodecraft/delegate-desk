// Cloudflare Worker for the DelegateDesk website (static files + /api forwarding).
// Deploy:  npx wrangler login   then   npx wrangler deploy
// Then in the dashboard: this Worker → Settings → Variables and Secrets → BACKEND_URL (and PROXY_SECRET).
{
  "name": "delegatedesk",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api"]
  },
  // Keep the variables you set in the dashboard when you deploy again.
  "keep_vars": true
}
