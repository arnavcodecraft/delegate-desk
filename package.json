{
  "name": "delegatedesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Delegate registration, instant allotment, payments and Companies Act-ready books for MUN-style events.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/src/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "seed": "tsx server/src/seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"server/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "restore": "tsx server/src/restore.ts",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "flag-icons": "^7.6.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "playwright": "^1.56.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
